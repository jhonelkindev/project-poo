<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="view.InstructionsPanel">
  <grid id="root01" binding="mainPanel" custom-create="true" default-binding="true" layout-manager="GridLayoutManager" row-count="1" column-count="3" same-size-horizontally="false" same-size-vertically="false" hgap="0" vgap="0">
    <margin top="140" left="210" bottom="140" right="243"/>
    <constraints>
      <xy x="0" y="0" width="1284" height="720"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <grid id="nav01" binding="navigationPanel" layout-manager="GridLayoutManager" row-count="7" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="0" vgap="3">
        <margin top="6" left="0" bottom="6" right="0"/>
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false">
            <preferred-size width="270" height="432"/>
          </grid>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <component id="btn1" class="javax.swing.JButton" binding="mechanicsButton">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false">
                <preferred-size width="196" height="60"/>
              </grid>
            </constraints>
            <properties>
              <text value="MECANICAS"/>
            </properties>
          </component>
          <component id="btn2" class="javax.swing.JButton" binding="level1Button">
            <constraints>
              <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false">
                <preferred-size width="196" height="60"/>
              </grid>
            </constraints>
            <properties>
              <text value="NIVEL 1"/>
            </properties>
          </component>
          <component id="btn3" class="javax.swing.JButton" binding="level2Button">
            <constraints>
              <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false">
                <preferred-size width="196" height="60"/>
              </grid>
            </constraints>
            <properties>
              <text value="NIVEL 2"/>
            </properties>
          </component>
          <component id="btn4" class="javax.swing.JButton" binding="level3Button">
            <constraints>
              <grid row="3" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false">
                <preferred-size width="196" height="60"/>
              </grid>
            </constraints>
            <properties>
              <text value="NIVEL 3"/>
            </properties>
          </component>
          <component id="btn5" class="javax.swing.JButton" binding="survivalButton">
            <constraints>
              <grid row="4" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false">
                <preferred-size width="196" height="60"/>
              </grid>
            </constraints>
            <properties>
              <text value="SUPERVIVENCIA"/>
            </properties>
          </component>
          <component id="btn6" class="javax.swing.JButton" binding="rankingButton">
            <constraints>
              <grid row="5" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false">
                <preferred-size width="196" height="60"/>
              </grid>
            </constraints>
            <properties>
              <text value="RANKING"/>
            </properties>
          </component>
          <component id="btn7" class="javax.swing.JButton" binding="backButton">
            <constraints>
              <grid row="6" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false">
                <preferred-size width="125" height="42"/>
              </grid>
            </constraints>
            <properties>
              <text value="VOLVER"/>
            </properties>
          </component>
        </children>
      </grid>
      <hspacer id="gap01">
        <constraints>
          <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false">
            <minimum-size width="32" height="1"/>
            <preferred-size width="32" height="1"/>
          </grid>
        </constraints>
      </hspacer>
      <grid id="content01" binding="contentPanel" layout-manager="GridLayoutManager" row-count="5" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="0" vgap="0">
        <margin top="27" left="0" bottom="0" right="0"/>
        <constraints>
          <grid row="0" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false">
            <preferred-size width="525" height="430"/>
          </grid>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <vspacer id="gap02">
            <constraints>
              <grid row="2" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false">
                <minimum-size width="1" height="20"/>
                <preferred-size width="1" height="20"/>
              </grid>
            </constraints>
          </vspacer>
          <scrollpane id="scroll01" binding="contentScrollPane">
            <constraints>
              <grid row="3" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false">
                <preferred-size width="455" height="246"/>
              </grid>
            </constraints>
            <properties/>
            <border type="none"/>
            <children>
              <component id="text01" class="javax.swing.JTextArea" binding="contentTextArea">
                <constraints/>
                <properties>
                  <editable value="false"/>
                  <lineWrap value="true"/>
                  <text value="Selecciona una seccion."/>
                  <wrapStyleWord value="true"/>
                </properties>
              </component>
            </children>
          </scrollpane>
          <vspacer id="gap03">
            <constraints>
              <grid row="4" column="0" row-span="1" col-span="2" vsize-policy="1" hsize-policy="0" anchor="0" fill="2" indent="0" use-parent-layout="false">
                <minimum-size width="1" height="60"/>
                <preferred-size width="1" height="60"/>
              </grid>
            </constraints>
          </vspacer>
          <component id="title01" class="javax.swing.JLabel" binding="sectionTitleLabel">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false">
                <preferred-size width="500" height="20"/>
              </grid>
            </constraints>
            <properties>
              <horizontalAlignment value="0"/>
              <text value="TRAINING: MECANICAS"/>
            </properties>
          </component>
        </children>
      </grid>
    </children>
  </grid>
</form>
